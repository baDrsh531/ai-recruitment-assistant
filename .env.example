# === Django ===============================================================
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === Base de donnees ======================================================
# Dev sans Docker : SQLite suffit.
DATABASE_URL=sqlite:///db.sqlite3
# Prod / Docker :
# DATABASE_URL=postgres://recruit:recruit@localhost:5432/recruit

# === Taches asynchrones ===================================================
# Vide => execution synchrone (CELERY_TASK_ALWAYS_EAGER), pratique en dev.
CELERY_BROKER_URL=
# CELERY_BROKER_URL=redis://localhost:6379/0

# === Serveur d'inference (Qwen) ===========================================
# API compatible OpenAI. Lance `python manage.py check_ai` pour decouvrir
# les identifiants exacts des modeles exposes par ton serveur.
#
# Le serveur doit etre joignable depuis cette machine : les NodePort
# Kubernetes ne sortent pas du reseau du cluster. En cas de timeout, verifie
# d'abord `Test-NetConnection <ip> -Port 30000`, pas la configuration ci-dessous.
LLM_BASE_URL=http://192.168.0.64:30000/v1
LLM_MODEL=qwen3.6-35b
LLM_API_KEY=not-needed
LLM_TIMEOUT=120

VLM_BASE_URL=http://192.168.0.64:30001/v1
VLM_MODEL=qwen3-vl-8b
VLM_API_KEY=not-needed
VLM_TIMEOUT=180

# Sans serveur joignable, le banc d'essai local prend le relais :
#   python manage.py mock_inference --port 30000
#   python manage.py mock_inference --port 30001
# puis :
#   LLM_BASE_URL=http://127.0.0.1:30000/v1  LLM_MODEL=mock-qwen3.6-35b
#   VLM_BASE_URL=http://127.0.0.1:30001/v1  VLM_MODEL=mock-qwen3-vl-8b

# === Embeddings ===========================================================
# none = desactive (defaut, voir python manage.py probe_semantic)
# local = fastembed ONNX | server = /v1/embeddings du serveur d'inference
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# === Agent d'orchestration ================================================
# Coupe par defaut, et volontairement : un agent qui appelle un modele sur
# chaque depot de CV depense des tokens sans qu'on le lui demande.
AGENT_ENABLED=False
# Plafond glissant sur 24 h, mesure sur les appels reellement passes. Atteint,
# l'agent s'arrete au dossier suivant plutot qu'au milieu d'un dossier.
AGENT_DAILY_TOKEN_BUDGET=200000
# Compte non humain qui signe le journal. Cree au besoin, sans mot de passe
# utilisable, et sans le droit de decider.
AGENT_USERNAME=agent

# === Echanges avec les candidats ==========================================
# Nom qui signe les messages et les documents. Vide = le nom de la marque.
OUTREACH_ORGANISATION=
# Delai de reponse annonce dans les gabarits. Il engage : `outreach_report`
# compte ensuite les dossiers restes muets au-dela.
OUTREACH_RESPONSE_DAYS=15
#
# Seul l'e-mail dispose d'un expediteur reel. Sans EMAIL_HOST, il part dans la
# console. Renseigner ces variables suffit a basculer sur un envoi reel :
# aucun code ne change.
#
# ATTENTION : ce fichier-ci est SUIVI PAR GIT. Aucune valeur reelle ne doit y
# figurer. Les identifiants vont dans `.env`, qui est ignore.
EMAIL_HOST=
DEFAULT_FROM_EMAIL=Recrutement.IA <ne-pas-repondre@example.com>
#
# Un fournisseur transactionnel est preferable a une boite personnelle : il
# gere la reputation d'envoi, les rebonds et les desabonnements, la ou un Gmail
# se fait bloquer au premier lot. L'adresse expeditrice doit y etre validee,
# sinon la connexion reussit et l'envoi est refuse ensuite.
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<identifiant SMTP donne par le fournisseur>
#   EMAIL_HOST_PASSWORD=<cle SMTP>
#
# Gmail reste possible pour un essai. Il exige un mot de passe d'APPLICATION,
# jamais celui du compte, et la double authentification doit etre active.
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=votre.adresse@gmail.com
#   EMAIL_HOST_PASSWORD=<seize lettres minuscules>
#
# Verifier la configuration sans rien envoyer :
#   python manage.py check_email
# Puis envoyer les trois messages types :
#   python manage.py outreach_selftest --to vous@example.com
# Sans SMTP, cette derniere ecrit des .eml ouvrables dans un vrai client.
#
# WhatsApp et SMS sont modelises mais non connectes : il faudrait un compte
# WhatsApp Business et un contrat operateur.
# DEMO_MODE=True ferme TOUS les canaux, e-mail compris.

# === Conformite / RGPD ====================================================
# Purge automatique des donnees candidat apres N jours (AI Act / RGPD).
DATA_RETENTION_DAYS=365
# Anonymisation par defaut a l'affichage (screening a l'aveugle).
BLIND_SCREENING_DEFAULT=False
